# Server-side n8n bridge. Never expose these with a VITE_ or NEXT_PUBLIC_ prefix.
N8N_TORRENT_BRIDGE_URL=https://n8n.example.com/webhook/vicky-ott-torrent-bridge
N8N_TORRENT_BRIDGE_TOKEN=replace-with-the-existing-portal-token

# Shared family sign-in. Use a strong unique password and a random 32+ character secret.
PORTAL_ACCESS_PASSWORD=replace-with-a-strong-access-password
PORTAL_SESSION_SECRET=replace-with-at-least-32-random-characters
